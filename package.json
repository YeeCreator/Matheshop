{
  "name": "matheshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:deps": "concurrently -k --raw -n UI,APP \"pnpm -C ../main-ui dev\" \"pnpm dev\"",
    "build": "pnpm build:deps && tsc -b && vite build",
    "build:deps": "pnpm -C ../main-ui build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173 && electron .\"",
    "desktop:dist": "pnpm build:deps && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder"
  },
  "dependencies": {
    "@main-ui/core": "workspace:*",
    "@main-ui/view-canvas": "workspace:*",
    "@main-ui/view-console": "workspace:*",
    "@main-ui/view-formula": "workspace:*",
    "@main-ui/view-inspector": "workspace:*",
    "@main-ui/view-table": "workspace:*",
    "katex": "^0.16.27",
    "main-ui": "workspace:^0.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.matheshop.app",
    "productName": "Matheshop",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
