{
  "name": "matheshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173 && electron .\"",
    "desktop:pack": "pnpm build && electron-builder --dir",
    "desktop:dist": "pnpm build && electron-builder",
    "predev": "pnpm -C ..\\viewport-kit-react build && pnpm -C ..\\main-ui-react build && pnpm install",
    "dev:with-dependent": "pnpm run predev && pnpm run dev"
  },
  "dependencies": {
    "katex": "^0.16.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "main-ui-react": "file:../main-ui-react",
    "viewport-kit": "file:../viewport-kit-react"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^7.3.0",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.matheshop.app",
    "productName": "Matheshop",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Education"
    }
  }
}
