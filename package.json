{
  "name": "matheshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:ui": "pnpm -C ../main-ui dev",
    "dev:viewport": "pnpm -C ../viewport-2d-kit dev",
    "dev:with-workspace": "concurrently -k --raw -n VIEWPORT,UI,APP \"pnpm run dev:viewport\" \"pnpm -C ../main-ui dev\" \"pnpm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173 && electron .\"",
    "desktop:pack": "pnpm build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --dir",
    "desktop:dist": "pnpm build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tanstack/react-table": "^8.21.3",
    "cmdk": "^1.1.1",
    "katex": "^0.16.27",
    "main-ui": "link:../main-ui",
    "react": "^19.0.0",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.2",
    "vue": "^3.5.0",
    "viewport-kit": "link:../viewport-2d-kit",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^7.3.0",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.matheshop.app",
    "productName": "Matheshop",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
