# Matheshop 本机环境配置（模板）
#
# 用法：复制本文件为 .env.local，填入你自己的真实路径。
#    cp .env.example .env.local
#
# 注意：.env.local 已被 .gitignore 排除，不会上传到仓库。
# 依「开源与非公开内容适配规范」规则 1 + 2：
#   - 公开侧（本文件）只写占位符
#   - 真实位置写在 .env.local（不入库）

# Python 符号计算引擎根目录
# 例：/Users/<you>/path/to/MathSymbolicComputationEngine
MATHSYMCALC_ENGINE_ROOT=

# 本机 Python 引擎服务端口
PORT=8000
